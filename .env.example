# ═══════════════════════════════════════════════════════════════════════════════
#  FPS Multiplayer Game — environment configuration
#
#  Copy this file to `.env` on your machine / VM and fill in REAL values:
#      cp .env.example .env
#
#  The real `.env` is gitignored and must NEVER be committed.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
# Port the Node/Express/Socket.IO server listens on. The reverse proxy
# (Nginx) forwards 80/443 to this port. Do NOT use 80 for the app itself.
PORT=3001

# Network interface to bind. 0.0.0.0 = all interfaces (needed behind a reverse
# proxy or for direct LAN play). Usually leave as-is.
HOST=0.0.0.0

# Set to "production" on the VM so cross-origin requests are blocked.
# Leave unset or use "development" locally.
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Required in production. This is where all accounts, leaderboard stats and
# kill counters live — do NOT delete or migrate the existing database.
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Local example: mongodb://localhost:27017/fps-game
MONGODB_URI=mongodb+srv://<database_user>:<database_password>@<cluster>.mongodb.net/<database_name>

# ── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret for login/session tokens. REQUIRED — generate a strong
# random value (never use a guessable one):
#     openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32

# ── CORS (optional, advanced) ────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API / Socket.IO
# cross-origin. In production the game is same-origin, so this should usually
# stay EMPTY. If you enable it, include your real domain:
#     CORS_ORIGIN=https://mygame.example.com
# Leave the line below commented out to use the default policy
# (block all cross-origin in production, allow all in development).
# CORS_ORIGIN=https://mygame.example.com

# ── Frontend (Vite build-time, dev only) ─────────────────────────────────────
# Used ONLY by the Vite dev server, which runs on a different port than the
# Node API. In production the game talks to window.location.origin, so this
# must be EMPTY when you build for the VM.
#     npm run dev   →  client on http://localhost:5173 → API here
# VITE_SERVER_URL=http://localhost:3001

# ── Firebase (optional, server-side Admin SDK only) ──────────────────────────
# Only needed if server/firebase.js is wired into the server. The client-side
# Firebase config ships inside the browser bundle (public by design) and must
# NOT be placed here. Paste the private key in quotes with \n escapes.
# FIREBASE_PROJECT_ID=...
# FIREBASE_PRIVATE_KEY_ID=...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_CLIENT_ID=...
# FIREBASE_CLIENT_X509_CERT_URL=...
# FIREBASE_DATABASE_URL=...